{
  "name": "bot-bureau",
  "productName": "Bot Bureau",
  "version": "0.1.9",
  "description": "Bot Bureau — different AI agents, work together for you",
  "author": "Aiden Huang <superboyyy6@gmail.com>",
  "homepage": "https://github.com/superboyyy/bot-bureau",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/fix-electron-identity.js",
    "start": "electron .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build:backend": "node scripts/build-backend.js",
    "build:icon": "cd .. && python3 assets/make_icon.py",
    "dist:mac:arm64": "node scripts/build-backend.js --platform darwin --arch arm64 && electron-builder --mac --arm64",
    "dist:mac:x64": "node scripts/build-backend.js --platform darwin --arch x64 && electron-builder --mac --x64",
    "dist:mac:universal": "node scripts/build-backend.js --platform darwin && electron-builder --mac --universal",
    "dist:win:x64": "node scripts/build-backend.js --platform win32 --arch x64 && electron-builder --win --x64",
    "dist:win:arm64": "node scripts/build-backend.js --platform win32 --arch arm64 && electron-builder --win --arm64",
    "dist:linux:x64": "node scripts/build-backend.js --platform linux --arch x64 && electron-builder --linux --x64",
    "dist:linux:arm64": "node scripts/build-backend.js --platform linux --arch arm64 && electron-builder --linux --arm64"
  },
  "build": {
    "appId": "app.botbureau.desktop",
    "productName": "Bot Bureau",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "bin/**",
      "build/icon.*",
      "build/icon-light.png",
      "build/icon-mac.png",
      "build/icon-mac-light.png"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "darkModeSupport": true,
      "artifactName": "Bot.Bureau-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Bot.Bureau-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Aiden Huang <superboyyy6@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Bot.Bureau-${version}-Linux-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    },
    "asarUnpack": [
      "bin/**"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  }
}
